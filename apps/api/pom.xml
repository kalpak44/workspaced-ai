<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath />
    </parent>

    <groupId>io.github.kalpak44</groupId>
    <artifactId>workspaced-ai-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>workspaced-ai API</name>
    <description>Manages the workspaces AI agents run in</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.enforcer.plugin.version>3.7.0</maven.enforcer.plugin.version>
        <fmt.plugin.version>2.29</fmt.plugin.version>
        <jacoco.plugin.version>0.8.16</jacoco.plugin.version>
        <sonar.plugin.version>5.8.0.7211</sonar.plugin.version>
        <!-- springdoc 3.x is the line built for Boot 4; 2.x targets Boot 3. -->
        <spring-doc.version>3.2.0</spring-doc.version>
        <fabric8.version>8.0.0</fabric8.version>
        <shedlock.version>7.10.1</shedlock.version>

        <!-- The floor `mvn verify` enforces. It lives here rather than in a CI step so a
             step deleted from the workflow cannot silently disable it. -->
        <jacoco.line.minimum>0.80</jacoco.line.minimum>

        <sonar.projectKey>workspaced-ai-api</sonar.projectKey>
        <sonar.organization>kalpak44</sonar.organization>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!-- The registry image the pipeline publishes to. Buildpacks cannot be told
             extra tags on the command line in Boot 4 (the `tags` user property is
             gone), so the `latest` alias is declared in the plugin configuration. -->
        <ghcr.image>ghcr.io/kalpak44/workspaced-ai-api</ghcr.image>
    </properties>

    <dependencies>
        <!-- starter-web is deprecated in Boot 4; webmvc is the supported name. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Spring Security as a JWT resource server: the API signs its own tokens at login
             and validates them on every request, so no session is kept on the server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- JPA for the entities; Flyway still owns the schema, and Hibernate only
             validates it against the mappings. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- spring-boot-flyway carries the auto-configuration, which Boot 4 moved out of the
             main jar: without it flyway-core sits on the classpath and never runs. The
             PostgreSQL module is separate from Flyway 10 onward. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Version comes from the Boot BOM, so a Boot upgrade moves the driver with it. Compile
             scope, not runtime: WorkspaceDeletions listens with its LISTEN/NOTIFY API. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Starts and stops each workspace's pod in the namespace the API runs in. On the
             JDK's own HTTP client rather than the default Vert.x one: Vert.x's threads keep
             the JVM from exiting, which surefire reports by killing its fork. -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>${fabric8.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.fabric8</groupId>
                    <artifactId>kubernetes-httpclient-vertx</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-httpclient-jdk</artifactId>
            <version>${fabric8.version}</version>
        </dependency>
        <!-- Runs each scheduled job on one API instance at a time, with the lock in PostgreSQL. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${spring-doc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The tests run against a real PostgreSQL rather than an in-memory stand-in, so a
             dialect difference cannot pass here and fail in the cluster. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- An in-memory API server that stores what is created, so pod handling is tested
             against real client calls without a cluster. -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <version>${fabric8.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Builds the container image with Cloud Native Buildpacks, so there is no
                 Dockerfile: the base image is the builder this plugin version pins, and it
                 moves with Spring Boot. CI passes the versioned imageName; `latest` is
                 tagged here because Boot 4 dropped the `build-image.tags` user property. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <!-- The cluster is x86; stated so a build on an ARM laptop matches. -->
                        <imagePlatform>linux/amd64</imagePlatform>
                        <!-- Buildpacks default to a fixed 1980 timestamp, so `docker images`
                             could not tell a fresh image from a stale one. -->
                        <createdDate>now</createdDate>
                        <tags>
                            <tag>${ghcr.image}:latest</tag>
                        </tags>
                        <env>
                            <BP_JVM_VERSION>${java.version}</BP_JVM_VERSION>
                            <!-- The memory calculator reserves a stack per thread before sizing
                                 the heap, and its default of 250 does not fit the pod's limit.
                                 Requests run on virtual threads, so few platform ones exist.
                                 OVERRIDE, not DEFAULT: the JVM buildpack writes its own default
                                 and that one wins. -->
                            <BPE_OVERRIDE_BPL_JVM_THREAD_COUNT>50</BPE_OVERRIDE_BPL_JVM_THREAD_COUNT>
                            <!-- Links the published package back to this repository. -->
                            <BP_OCI_SOURCE>https://github.com/kalpak44/workspaced-ai</BP_OCI_SOURCE>
                            <!-- GitHub's release-asset CDN intermittently takes longer than the
                                 buildpack's 5s default to answer a redirect, which fails the image
                                 build with "timeout awaiting response headers" while fetching the
                                 JRE or Syft. Give that one timeout room; the download itself is
                                 still checksum-verified. -->
                            <BP_RESPONSE_HEADER_TIMEOUT>60</BP_RESPONSE_HEADER_TIMEOUT>
                        </env>
                    </image>
                </configuration>
            </plugin>

            <!-- The pom declares Java 25 but the compiler only needs a 25 bytecode
                 target, which an older JDK can be asked for and then fail on a 25
                 language feature. Fail on the JDK itself instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- google-java-format, with no style settings to argue about. `fmt:check`
                 is the CI gate; `fmt:format` is what fixes a failure. -->
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt.plugin.version}</version>
            </plugin>

            <!-- `report` feeds Sonar; `check` fails `verify` below the line floor. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
