# WORKSPACE_NAMESPACE is the namespace the workspaces' Services are in, and DNS_RESOLVER
# the cluster's DNS. The variable in proxy_pass makes nginx look each name up per request
# through that resolver, rather than once at start.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Probes reach the pod by its IP, which the workspace pattern below would also match, so
# this server comes first: nginx takes the first regular expression that matches.
server {
  listen 8080 default_server;
  server_name ~^[0-9.]+$;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 404;
  }

  error_page 404 /404.html;
  location = /404.html {
    root /usr/share/nginx/gateway;
    internal;
  }
}

server {
  listen 8080;
  # The first label, box-<name>, is the name of the workspace's Service too, so it passes
  # through unchanged; the domain is whatever the route sends here. Any other host falls to
  # the server above.
  server_name ~^(?<service>box-[a-z0-9-]+)\.;
  client_max_body_size 100m;

  location / {
    proxy_pass http://$service.${WORKSPACE_NAMESPACE}.svc.cluster.local;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # The ingress set these from the visitor; pass them on rather than add this hop.
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  # A name with no Service does not resolve, and a stopped workspace's Service has no
  # endpoint. nginx reports both as 502, which reads as an outage, not as nothing here.
  # A named location, so a workspace's own /404.html is never shadowed.
  error_page 502 504 =404 @nothing;
  location @nothing {
    root /usr/share/nginx/gateway;
    try_files /404.html =404;
  }
}
