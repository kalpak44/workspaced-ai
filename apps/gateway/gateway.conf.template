# Resolve enabled domain names through API_URL, then relay through AGENT_HUB_URL.
# DNS_RESOLVER is the cluster DNS; upstream service names are resolved per request.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Probes reach the pod by its IP, which the workspace pattern below would also match, so
# this server comes first: nginx takes the first regular expression that matches.
server {
  listen 8080 default_server;
  server_name ~^[0-9.]+$;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 404;
  }

  error_page 404 /404.html;
  location = /404.html {
    root /usr/share/nginx/gateway;
    internal;
  }
}

server {
  listen 8080;
  # Only box- names may resolve to a workspace. The API owns the name-to-VM mapping.
  server_name ~^box-(?<workspace_name>[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)\.;
  client_max_body_size 100m;

  location / {
    auth_request /_resolve;
    auth_request_set $workspace_target $upstream_http_x_workspace_target;
    proxy_pass ${AGENT_HUB_URL}$workspace_target$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Internal hub routes refuse forwarded ingress headers. Host still identifies the site.
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Real-IP "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  location = /_resolve {
    internal;
    proxy_pass ${API_URL}/api/v1/internal/web-domains/$workspace_name;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Real-IP "";
  }

  # Missing, disabled and unreachable workspaces get the same friendly 404.
  # A named location, so a workspace's own /404.html is never shadowed.
  error_page 401 403 500 502 503 504 =404 @nothing;
  location @nothing {
    root /usr/share/nginx/gateway;
    try_files /404.html =404;
  }
}
