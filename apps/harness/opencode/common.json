{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "instructions": [
    "/usr/share/harness/instructions/system.md",
    "/home/workspace/.config/workspaced/instructions/*.md"
  ],
  "share": "disabled",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
